APP_NAME="CodeGuardian AI"
APP_ENV="development"
DEBUG=True

# Database Configuration
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="codeguardian"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="codeguardian_db"

# Redis Configuration
REDIS_HOST="redis"
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT=5672
RABBITMQ_USER="codeguardian"
RABBITMQ_PASSWORD="change-me"

# GitHub Configuration
# A fine-grained token: Pull requests read and write, Contents read.
GITHUB_TOKEN="change-me"
# The same value goes in the webhook settings on GitHub.
GITHUB_WEBHOOK_SECRET="change-me"
# Comma-separated owner/name values. Empty means nothing is reviewed.
REVIEW_REPOSITORIES="example-org/example-repo"

# LLM Configuration (Local Ollama)
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://host.docker.internal:11434"
LLM_MODEL="llama3.2"
